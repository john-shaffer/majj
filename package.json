{
  "name": "majj",
  "displayName": "majj",
  "description": "Magit-style interface for Jujutsu (jj)",
  "version": "0.0.1",
  "publisher": "jdsha",
  "preview": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "jj",
    "jujutsu",
    "magit"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "majj.abandon",
        "title": "Abandon Change at Point",
        "category": "Majj"
      },
      {
        "command": "majj.cancelEditing",
        "title": "Cancel Editing Description",
        "category": "Majj"
      },
      {
        "command": "majj.commit",
        "title": "Commit Working Copy",
        "category": "Majj"
      },
      {
        "command": "majj.discard",
        "title": "Discard at Point",
        "category": "Majj"
      },
      {
        "command": "majj.edit",
        "title": "Edit Change at Point",
        "category": "Majj"
      },
      {
        "command": "majj.finishEditing",
        "title": "Finish Editing Description",
        "category": "Majj"
      },
      {
        "command": "majj.help",
        "title": "Help",
        "category": "Majj"
      },
      {
        "command": "majj.rebase",
        "title": "Rebase Change at Point",
        "category": "Majj"
      },
      {
        "command": "majj.redo",
        "title": "Redo Last Undone Operation",
        "category": "Majj"
      },
      {
        "command": "majj.refresh",
        "title": "Refresh Status",
        "category": "Majj"
      },
      {
        "command": "majj.restore",
        "title": "Restore Changes",
        "category": "Majj"
      },
      {
        "command": "majj.split",
        "title": "Split Selected Changes",
        "category": "Majj"
      },
      {
        "command": "majj.squash",
        "title": "Squash Changes",
        "category": "Majj"
      },
      {
        "command": "majj.status",
        "title": "Status",
        "category": "Majj"
      },
      {
        "command": "majj.toggleFold",
        "title": "Toggle Section at Point",
        "category": "Majj"
      },
      {
        "command": "majj.toggleSelect",
        "title": "Toggle Selection at Point",
        "category": "Majj"
      },
      {
        "command": "majj.undo",
        "title": "Undo Last Operation",
        "category": "Majj"
      },
      {
        "command": "majj.visit",
        "title": "Visit Change or File at Point",
        "category": "Majj"
      }
    ],
    "configuration": {
      "title": "Majj",
      "properties": {
        "majj.autoRefresh.mode": {
          "type": "string",
          "enum": [
            "off",
            "poll",
            "watch"
          ],
          "enumDescriptions": [
            "Only refresh when the status command or `majj.refresh` is run.",
            "Refresh every `majj.autoRefresh.pollInterval` seconds while a majj view is visible.",
            "Refresh when jj records a new operation or a file in the workspace changes."
          ],
          "default": "watch",
          "description": "How the status and change views keep themselves up to date."
        },
        "majj.autoRefresh.pollInterval": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Seconds between refreshes when majj.autoRefresh.mode is \"poll\"."
        },
        "majj.jjPath": {
          "type": "string",
          "default": "jj",
          "description": "Path to the jj executable."
        },
        "majj.status.limit": {
          "type": "integer",
          "default": 50,
          "minimum": 0,
          "description": "Maximum number of changes shown in the status view's change graph. 0 means no limit."
        },
        "majj.status.recentChanges": {
          "type": "integer",
          "default": 10,
          "minimum": 0,
          "markdownDescription": "Number of the working copy's ancestors always shown in the status view's change graph, so that it has some context even when everything is pushed. Only applies when `#majj.status.revset#` is empty."
        },
        "majj.status.revset": {
          "type": "string",
          "default": "",
          "markdownDescription": "Revset shown in the status view's change graph. Empty uses jj's own default (`revsets.log`), e.g. set it to `ancestors(@, 10) | descendants(@)` to show only changes around the working copy."
        }
      }
    },
    "configurationDefaults": {
      "[majj]": {
        "editor.folding": false,
        "editor.guides.indentation": false,
        "editor.lineNumbers": "off",
        "editor.minimap.enabled": false,
        "editor.occurrencesHighlight": "off",
        "editor.renderWhitespace": "none",
        "editor.stickyScroll.enabled": false,
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.wordWrap": "off"
      }
    },
    "keybindings": [
      {
        "command": "majj.abandon",
        "key": "a",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.cancelEditing",
        "key": "ctrl+c ctrl+k",
        "when": "editorTextFocus && editorLangId == jjdescription"
      },
      {
        "command": "majj.commit",
        "key": "c",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.discard",
        "key": "k",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.edit",
        "key": "e",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.finishEditing",
        "key": "ctrl+c ctrl+c",
        "when": "editorTextFocus && editorLangId == jjdescription"
      },
      {
        "command": "majj.help",
        "key": "shift+-",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.help",
        "key": "shift+/",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.rebase",
        "key": "r",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.redo",
        "key": "ctrl+y",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.refresh",
        "key": "g",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.restore",
        "key": "shift+x",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.split",
        "key": "s",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.squash",
        "key": "shift+s",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.status",
        "key": "alt+x j"
      },
      {
        "command": "majj.toggleFold",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.toggleSelect",
        "key": "space",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.undo",
        "key": "ctrl+z",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "majj.visit",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == majj"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "key": "q",
        "when": "editorTextFocus && editorLangId == majj"
      }
    ],
    "languages": [
      {
        "id": "jjdescription",
        "aliases": [
          "jj Description"
        ],
        "extensions": [
          ".jjdescription"
        ]
      },
      {
        "id": "majj",
        "aliases": [
          "Majj"
        ],
        "extensions": [
          ".majj"
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "majj.abandon",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.cancelEditing",
          "when": "editorLangId == jjdescription"
        },
        {
          "command": "majj.commit",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.discard",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.edit",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.finishEditing",
          "when": "editorLangId == jjdescription"
        },
        {
          "command": "majj.help",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.rebase",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.redo",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.refresh",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.restore",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.split",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.squash",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.toggleFold",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.toggleSelect",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.undo",
          "when": "editorLangId == majj"
        },
        {
          "command": "majj.visit",
          "when": "editorLangId == majj"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test:unit": "node --test \"out/test/unit/**/*.test.js\"",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
